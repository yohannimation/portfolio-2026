{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - Admin projects{% endblock %}

{% block body %}
    <section>
        <h1>Projects dashboard</h1>
        <a href="{{ path('app.admin.project.create') }}" class="button">Create</a>
        <table class="table table-dark my-3">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Source</th>
                    <th scope="col">Miniature</th>
                    <th scope="col">Date</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for project in projects %}
                    <tr>
                        <td scope="row">{{ project.id }}</td>
                        <td>{{ project.name }}</td>
                        <td>{{ project.description }}</td>
                        <td>{{ project.source }}</td>
                        <td>
                            <img
                                src="{{ vich_uploader_asset(project) }}"
                                alt="{{ project.name }} miniature"
                                class="w-25"
                            >
                        </td>
                        <td>{{ project.date | date('d/m/Y') }}</td>
                        <td>{{ project.active ? "<span class='badge text-bg-success'>Active</span>" : "<span class='badge text-bg-danger'>Disabled</span>" }}</td>
                        <td>
                            <form
                                action="{{ path('app.admin.project.delete', { id: project.id }) }}"
                                onSubmit="return confirm('Delete {{project.name}} project ?')"
                                method="POST"
                            >
                                <a href="{{ path('app.admin.project.update', { id: project.id }) }}" class="btn btn-warning">Edit</a>
                                <input type="hidden" name="token" value="{{ csrf_token('delete' ~ project.id) }}">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
