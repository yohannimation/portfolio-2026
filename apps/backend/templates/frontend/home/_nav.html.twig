<nav class="cta-nav shadow-container">
	<h2>Catégories</h2>
	<ul class="cta-nav-list">
		{% for category in categories %}
			{% if category.active %}
				<li class="cta-nav-list-item">
					<a href="{{ path('app.front.category.show', {id: category.id, slug: category.slug}) }}" title="Catégorie {{ category.name }}">
						{{ category.name }}
						{{ ux_icon('lucide:chevron-right') }}
					</a>
				</li>
			{% endif %}
		{% endfor %}
		<li class="cta-nav-list-item">
			<a href="{{ path('app.front.about-me') }}" title="Catégorie à propos de moi">
				Et moi ?
                {{ ux_icon('lucide:chevron-right') }}
			</a>
		</li>
	</ul>
</nav>
