{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} - {{ category.name }}{% endblock %}
{% block ogTitle %}{{ parent() }} - {{ category.name }}{% endblock %}

{% block description %}
    {{ category.description|default('') }}
{% endblock %}
{% block ogDescription %}
    {{ category.description|default('') }}
{% endblock %}

{% block body %}
    <div class="page-title" data-controller="scrolltop">
        <h1>{{ category.name }}</h1>
        <button
            class="button button-transparent icon-btn hidden"
            data-action="click->scrolltop#scrollToTop"
            data-scrolltop-target="triggerButton"
        >
            {{ ux_icon('lucide:arrow-up', {style: 'height: 100%; width: 100%'}) }}
        </button>
    </div>
    {% if category.description %}
        <p>
            {{ category.description | render_icons | raw }}
        </p>
    {% endif %}

    <section class="shadow-container project-list">
        {% for project in projects|filter(proj => proj.active) %}
            {% include 'frontend/category/_project_item.html.twig' with {
                project: project,
                index: loop.index
            } %}
        {% endfor %}
    </section>
    
{% endblock %}
