<article
    class="project-list-item"
    {{ project.sourceType == 'video' ? 'data-controller="videoplayer"' : '' }}
>
    <header
        id="{{ project.slug }}"
        class="d-flex align-items-center gap-2"
    >
        <h2>{{ project.name }}</h2> - <time datetime="{{ project.date | date('Y-m-d') }}">{{ project.date | date('d/m/Y') }}</time>
    </header>
    <div class="row m-0 content {{ index is even ? 'is-reversed' }}">
        <div class="col-sm-6 miniature">

            {# Tags #}
            {% if project.tags|length > 0 %}
                <ul class="tags">
                    {% for tag in project.tags %}
                        <li class="tags-item">{{ tag.name }}</li>
                    {% endfor %}
                </ul>
            {% endif %}

            <img src="{{ vich_uploader_asset(project) }}" class="miniature-img" alt="{{ project.name }} miniature" loading="lazy">

            {# CTA #}
            <div class="miniature-footer {{ index is even ? 'is-reversed' }}">
                {% if project.sourceType == 'link' %}
                    {# button to visit the source #}
                    <a href="{{ project.source }}" class="button button-xs" target="_blank" title="Visiter le projet {{ project.name }}">
                        {{ ux_icon('lucide:square-arrow-out-up-right', {class: 'icon-xl'}) }} Découvrir
                    </a>
                {% endif %}
                {% if project.sourceType == 'image' %}
                    {# big image to display #}
                {% endif %}
                {% if project.sourceType == 'video' %}
                    {# video player to display #}
                    <button class="button button-xs" title="Visualiser la vidéo du projet {{ project.name }}" data-action="mousedown->videoplayer#videoPlayerToggle">
                        {{ ux_icon('lucide:play', {class: 'icon-xl'}) }} Lecture
                    </button>
                {% endif %}
            </div>
        </div>
        <div class="col-sm-6 description">
            <p>Projet <span>{{ project.type.value }}</span></p>
            <p>
                {{ project.description | render_icons | raw }}
            </p>
        </div>
    </div>
    {% if project.sourceType == 'video' %}
        <div
            class="video-player"
            data-videoplayer-target="videoPlayer"
            data-action="mousedown->videoplayer#videoPlayerToggle"
            data-videoplayer-url-value="{{ project.source }}"
            data-videoplayer-title-value="{{ project.name }}"
        >
        </div>
    {% endif %}
</article>
