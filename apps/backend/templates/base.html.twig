<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <link rel="icon" href="/images/favicon.ico">
        <meta name="viewport" content="width=device-width,initial-scale=1">

        <meta name="author" content="Yohann RENAULD">
        <meta property="og:type" content="website">

        <title>{% block title %}Yohannimation{% endblock %}</title>
        <meta property="og:title" content="{% block ogTitle %}Yohannimation{% endblock %}">

        <link rel="canonical" href="{{ app.request.uri }}">
        <meta property="og:url" content="{{ app.request.uri }}">
        
        <meta name="description" content="{% block description %}{% endblock %}">
        <meta property="og:description" content="{% block ogDescription %}{% endblock %}">

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        {% include "layout/_header.html.twig" %}
        <main class="container-sm my-5 main">
            {% block body %}{% endblock %}
        </main>
        {% include "layout/_footer.html.twig" %}
    </body>
</html>
