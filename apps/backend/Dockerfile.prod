# Stage 1: Builder
FROM php:8.3-fpm-alpine AS builder

# Install build-time dependencies
RUN apk add --no-cache \
        icu-dev \
        libzip-dev \
        zip \
        unzip \
        git \
        bash

RUN docker-php-ext-install -j$(nproc) pdo pdo_mysql intl zip opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Install dependencies without scripts to avoid failures before code is copied
COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts

# Copy code and dump autoload
COPY . .
RUN composer dump-autoload --optimize --no-dev

# Stage 2: Final
FROM php:8.3-fpm-alpine

# Install only runtime dependencies
RUN apk add --no-cache \
        icu-libs \
        libzip \
        bash

# Remove the redundant extension installation in the final stage.
# The extensions are already compiled and present in the image
# if we copy the whole folder from builder, BUT actually
# docker-php-ext-install compiles them into the PHP binary/extensions dir.
# Since we are using the same base image, and we want to avoid
# installing build-deps (gcc, etc) in the final image,
# we should copy the compiled extensions from the builder stage.

WORKDIR /var/www/html

# Copy compiled PHP extensions from builder
COPY --from=builder /usr/local/lib/php/extensions /usr/local/lib/php/extensions
COPY --from=builder /usr/local/etc/php/conf.d /usr/local/etc/php/conf.d

# Copy optimized application from builder
COPY --from=builder /var/www/html /var/www/html

# Create an empty .env file to prevent Symfony Dotenv from crashing in prod
RUN touch /var/www/html/.env

# Set production permissions
RUN mkdir -p /var/www/html/var /var/www/html/public && chown -R www-data:www-data /var/www/html/var /var/www/html/public
RUN chmod +x /var/www/html/docker-entrypoint.prod.sh

EXPOSE 9000

ENTRYPOINT ["/var/www/html/docker-entrypoint.prod.sh"]
